    <comp lib="8" loc="(60,40)" name="Text">
      <a name="text" val="Laboratorio: de transistores a compuertas, a un sumador y a la memoria"/>
      <a name="font" val="SansSerif bold 20"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="8" loc="(60,66)" name="Text">
      <a name="text" val="Haz clic en las entradas con la herramienta de la mano para cambiarlas. Para ver los transistores por dentro: pestaña Simular, arbol de la simulacion &gt; doble clic en cada bloque (U_NOT, U_FA, U_SUMA4...)."/>
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="8" loc="(60,120)" name="Text">
      <a name="text" val="1. Compuertas hechas con transistores"/>
      <a name="font" val="SansSerif bold 16"/>
      <a name="halign" val="left"/>
    </comp>
