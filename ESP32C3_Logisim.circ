      <a name="text" val="Latch D con 4 NAND (cada NAND son 4 transistores)"/>
      <a name="font" val="SansSerif bold 16"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="8" loc="(60,80)" name="Text">
      <a name="text" val="E = 1: Q copia a D (transparente).  E = 0: Q se queda guardado gracias a la realimentacion (Q y Qn se sostienen mutuamente).  R = 1 lo borra (Q = 0)."/>
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="8" loc="(60,420)" name="Text">
      <a name="text" val="Al encender, Q y Qn pueden quedar en rojo (E = indefinido): en un chip real el latch arranca en 0 o en 1 al azar. Por eso los circuitos reales tienen un reset al encender."/>
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
    </comp>
