    <comp lib="8" loc="(60,40)" name="Text">
      <a name="text" val="Sumador completo CMOS de 28 transistores (&quot;mirror adder&quot;)"/>
      <a name="font" val="SansSerif bold 16"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="8" loc="(60,60)" name="Text">
      <a name="text" val="S = A xor B xor Cin ;  Cout = A.B + Cin.(A+B).  Los nombres A, B, Cin, Cn y Sn son etiquetas: cada compuerta de transistor esta conectada a la senal con ese nombre."/>
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="8" loc="(170,470)" name="Text">
      <a name="text" val="Red de acarreo: 10 transistores"/>
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="8" loc="(170,486)" name="Text">
      <a name="text" val="arriba P (sube Cn a 1), abajo N (baja Cn a 0)"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="8" loc="(450,470)" name="Text">
      <a name="text" val="Red de suma: 14 transistores"/>
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="8" loc="(450,486)" name="Text">
      <a name="text" val="usa Cn: la suma reutiliza el acarreo negado"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="8" loc="(780,470)" name="Text">
      <a name="text" val="2 inversores: 4 transistores"/>
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="8" loc="(780,486)" name="Text">
      <a name="text" val="Cout = NOT Cn ;  S = NOT Sn"/>
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="8" loc="(60,520)" name="Text">
      <a name="text" val="P (con circulito): conduce si su compuerta = 0; deja pasar el 1 de VDD&#10;N: conduce si su compuerta = 1; deja pasar el 0 de GND"/>
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
    </comp>
  </circuit>
