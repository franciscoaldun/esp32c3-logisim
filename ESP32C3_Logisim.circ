      <a name="halign" val="left"/>
    </comp>
    <comp lib="8" loc="(700,776)" name="Text">
      <a name="text" val="Ejemplo: A = 0111 (7), B = 0101 (5) -&gt; S = 1100 (C = 12)"/>
