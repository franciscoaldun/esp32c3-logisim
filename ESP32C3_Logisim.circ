      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="8" loc="(700,760)" name="Text">
      <a name="text" val="Haz clic en cada bit de los pines A4 y B4."/>
