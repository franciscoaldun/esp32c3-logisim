      <a name="halign" val="left"/>
    </comp>
    <comp lib="8" loc="(560,400)" name="Text">
      <a name="text" val="Prueba: A = 1, B = 1, Cin = 0 -&gt; S = 0 y Cout = 1 (1 + 1 = 10 en binario)"/>
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="8" loc="(60,560)" name="Text">
      <a name="text" val="3. Sumador de 4 bits (112 transistores): A + B"/>
